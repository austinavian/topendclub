---
import { primaryNav } from '../data/nav';
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header class="gnav" data-gnav>
  <nav class="gnav__inner" aria-label="Main">
    <a class="gnav__home" href="/" aria-label="The Top End Club, home">
      <span class="gnav__icon" aria-hidden="true"></span>
    </a>
    <ul class="gnav__list" role="list">
      {primaryNav.map((item) => (
        <li>
          <a class:list={['gnav__link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .gnav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    background: var(--glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .gnav.is-scrolled { border-bottom-color: var(--glass-border); }

  .gnav__inner {
    width: min(1024px, 100% - var(--gutter) * 2);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .gnav__home { display: flex; align-items: center; height: 100%; padding-inline: 8px; margin-inline: -8px; opacity: 0.88; transition: opacity var(--dur) var(--ease); }
  .gnav__home:hover { opacity: 1; }
  .gnav__icon {
    display: block;
    width: 34px;
    height: 20px;
    background: var(--text);
    -webkit-mask: url('/brand/TEC_ICON_BLACK.svg') center / contain no-repeat;
    mask: url('/brand/TEC_ICON_BLACK.svg') center / contain no-repeat;
  }

  .gnav__list { display: flex; align-items: center; justify-content: space-between; flex: 1; max-width: 760px; margin: 0; }
  .gnav__link {
    display: block;
    padding: 0 8px;
    font-size: 12px;
    line-height: var(--nav-h);
    letter-spacing: -0.01em;
    font-weight: 400;
    color: var(--text);
    opacity: 0.8;
    text-decoration: none;
    transition: opacity var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .gnav__link:hover { opacity: 1; text-decoration: none; }
  .gnav__link.is-active { opacity: 1; font-weight: 600; }

  /* On phones the bottom tab bar takes over, as in the concept mockup */
  @media (max-width: 833px) {
    .gnav { display: none; }
  }
</style>
