---
// Mobile tab bar, after the concept mockup in CONCEPTS/blank_master_page_with_title.jpg.
// Shop from the mockup is swapped for D.R.A.W. until there is a shop.
import { tabBar } from '../data/nav';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<nav class="tabbar" aria-label="Sections">
  <ul class="tabbar__list" role="list">
    {tabBar.map((t) => (
      <li>
        <a class:list={['tabbar__item', `tabbar__item--${t.icon}`, { 'is-active': isActive(t.href) }]} href={t.href} aria-current={isActive(t.href) ? 'page' : undefined}>
          <span class="tabbar__icon" aria-hidden="true">
            {t.icon === 'events' && (
              <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="20" height="20" rx="5"/><rect x="8.5" y="8.5" width="6" height="5" rx="1.2" fill="currentColor" stroke="none"/><path d="M8.5 19h11"/></svg>
            )}
            {t.icon === 'draw' && (
              <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 23s-9-5.4-9-12a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.6-9 12-9 12Z"/></svg>
            )}
            {t.icon === 'home' && <span class="tabbar__logo"></span>}
            {t.icon === 'news' && (
              <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4.5h16a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-8l-5 4v-4H6a3 3 0 0 1-3-3v-10a3 3 0 0 1 3-3Z"/><path d="M10.2 10.2c-1 .3-1.6 1.1-1.6 2.2 0 .9.6 1.5 1.4 1.5.7 0 1.3-.5 1.3-1.3 0-.7-.5-1.2-1.1-1.3.1-.6.6-1 1.2-1.2M16.2 10.2c-1 .3-1.6 1.1-1.6 2.2 0 .9.6 1.5 1.4 1.5.7 0 1.3-.5 1.3-1.3 0-.7-.5-1.2-1.1-1.3.1-.6.6-1 1.2-1.2" stroke-width="1.4"/></svg>
            )}
            {t.icon === 'about' && (
              <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="14" cy="14" r="10"/><path d="M14 13v6"/><circle cx="14" cy="9.2" r="0.6" fill="currentColor"/></svg>
            )}
          </span>
          <span class="tabbar__label">{t.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabbar { display: none; }

  @media (max-width: 833px) {
    .tabbar {
      display: block;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 100;
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--tab-glass);
      -webkit-backdrop-filter: saturate(180%) blur(24px);
      backdrop-filter: saturate(180%) blur(24px);
      border-top: 1px solid var(--glass-border);
    }
  }

  .tabbar__list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: var(--tabbar-h);
    margin: 0 auto;
    max-width: 560px;
    padding-inline: 8px;
  }

  .tabbar__item {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--tab-ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur) var(--ease), transform var(--dur-micro) var(--ease);
  }
  .tabbar__item:hover { text-decoration: none; color: var(--text); }
  .tabbar__item:active { transform: scale(0.92); }
  .tabbar__item.is-active { color: var(--text); }

  .tabbar__icon { width: 28px; height: 28px; display: grid; place-items: center; }
  .tabbar__icon svg { width: 26px; height: 26px; }

  .tabbar__item--home .tabbar__icon { width: 52px; }
  .tabbar__logo {
    display: block;
    width: 50px;
    height: 28px;
    background: currentColor;
    -webkit-mask: url('/brand/TEC_ICON_BLACK.svg') center / contain no-repeat;
    mask: url('/brand/TEC_ICON_BLACK.svg') center / contain no-repeat;
  }
  .tabbar__item--home.is-active .tabbar__logo { background: var(--tec-red-gradient); }

  .tabbar__label { font-size: 10px; line-height: 1.2; font-weight: 500; letter-spacing: 0.01em; }
</style>
