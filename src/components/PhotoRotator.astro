---
// A stack of event photos that shuffles on every visit and crossfades on a timer.
// Only the photo on screen (and the next one) is downloaded. Without JavaScript the first photo shows.
import photos from '../data/photos-2026.json';

interface Props {
  keys: string[];          // photo keys from photos-2026.json
  interval?: number;       // ms between photos
  sizes?: string;
  caption?: boolean;       // show the photo's description in the corner
  class?: string;
}
const { keys, interval = 6500, sizes = '100vw', caption = false, class: cls } = Astro.props;
const list = keys.map((k) => photos.find((p) => p.key === k)!).filter(Boolean);
const base = '/photos/2026/';
const set = (k: string) => `${base}${k}-sm.webp 960w, ${base}${k}.webp 1920w`;
---
<div class:list={['rot', cls]} data-rotator data-interval={interval} aria-roledescription="slideshow">
  {list.map((p, i) => (
    <picture class="rot__slide" data-alt={p.alt} aria-hidden="true">
      <source type="image/webp" data-srcset={set(p.key)} sizes={sizes} />
      <img data-src={`${base}${p.key}.jpg`} alt="" style={`object-position:${p.focus}`} decoding="async" />
    </picture>
  ))}
  <noscript>
    <picture class="rot__slide is-active">
      <source type="image/webp" srcset={set(list[0].key)} sizes={sizes} />
      <img src={`${base}${list[0].key}.jpg`} alt={list[0].alt} style={`object-position:${list[0].focus}`} />
    </picture>
  </noscript>
  {caption && <p class="rot__caption" data-rot-caption aria-hidden="true"></p>}
  <span class="sr-only" data-rot-label role="img" aria-label={list[0].alt}></span>
</div>

<style>
  .rot { position: relative; overflow: hidden; isolation: isolate; }
  .rot__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .rot__slide img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); }
  .rot__slide.is-active { opacity: 1; z-index: 1; }
  .rot__slide.is-active img { transform: scale(1); transition: transform var(--rot-dur, 9s) linear; }
  .rot__caption {
    position: absolute; z-index: 2; right: 24px; bottom: var(--rot-caption-bottom, 16px); max-width: min(340px, 70%);
    margin: 0; font-size: 12px; line-height: 1.35; letter-spacing: 0; text-align: right;
    color: rgba(255, 255, 255, 0.9); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5), 0 0 18px rgba(0, 0, 0, 0.45);
    opacity: 0; transition: opacity 0.6s var(--ease-out);
  }
  .rot__caption.is-on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .rot__slide, .rot__slide.is-active img { transition: opacity 0.3s linear; }
    .rot__slide img { transform: none; }
  }
</style>
