---
// For events with no flyer: a stand-in drawn in the style of the neighboring
// flyer (emblem on top, date in wide-spaced capitals, season line under it).
import type { Ev } from '../lib/events';
interface Props { event: Ev; size?: 'sm' | 'lg' }
const { event: e, size = 'sm' } = Astro.props;
const md = e.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<div class:list={['poster', `poster--${size}`]}>
  <img class="poster__emblem" src="/brand/TEC_ICON_RED_GRADIENT.svg" alt="" aria-hidden="true" />
  <p class="poster__date">{md}</p>
  <p class="poster__sub">{e.season} {e.year} event</p>
  {e.private && <p class="poster__private">Private event</p>}
</div>
<style>
  .poster {
    height: 100%; display: grid; place-content: center; justify-items: center; gap: 0.5em; text-align: center;
    background:
      radial-gradient(110% 70% at 50% 0%, color-mix(in srgb, var(--ev-accent) 16%, transparent), transparent 70%),
      var(--ev-bg);
    color: var(--ev-accent);
    font-size: 14px;
  }
  .poster--lg { font-size: clamp(18px, 2.2vw, 24px); }
  .poster__emblem { width: 6.5em; height: auto; margin-bottom: 0.6em; filter: drop-shadow(0 6px 10px rgba(0,0,0,0.15)); }
  .poster__date {
    font-size: 2.1em; line-height: 1; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.12em; margin-right: -0.12em;
    font-variation-settings: "opsz" 28;
  }
  .poster__sub, .poster__private {
    font-size: 0.72em; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em; margin-right: -0.2em;
    color: color-mix(in srgb, var(--ev-accent) 55%, #6e6e73);
  }
  .poster__private { margin-top: 0.6em; padding: 0.35em 0.9em; border: 1px solid currentColor; border-radius: 99px; }
</style>
