---
import BorrowedPoster from './BorrowedPoster.astro';
import { styleFor, shortDate, raisedText, type Ev } from '../lib/events';
interface Props { event: Ev; delay?: number }
const { event: e, delay = 0 } = Astro.props;
const s = styleFor(e);
const raised = raisedText(e);
---
<a class="card ev-card reveal" href={`/events/${e.id}/`} style={`--reveal-delay:${delay}ms; --ev-accent:${s.accent}; --ev-bg:${s.bg}`}>
  <div class:list={['ev-card__art', { 'is-dark': s.dark, 'is-borrowed': s.borrowed }]}>
    {e.flyer ? (
      <img src={`/flyers/${e.flyer}-sm.jpg`} alt={`${e.season} ${e.year} event flyer`} loading="lazy" decoding="async" width="480" height="621" />
    ) : (
      <BorrowedPoster event={e} />
    )}
  </div>
  <div class="ev-card__body">
    <p class="ev-card__date t-caption">{shortDate(e.date)}</p>
    <h3 class="t-title-3">{e.season} {e.year}</h3>
    <p class="t-callout t-secondary">{e.name}</p>
    <div class="ev-card__meta">
      {e.private && <span class="badge">Private event</span>}
      {raised && <span class="t-caption t-secondary t-tabular">{raised} raised</span>}
    </div>
  </div>
</a>

<style>
  .ev-card { display: flex; flex-direction: column; height: 100%; }
  .ev-card__art {
    position: relative; aspect-ratio: 4 / 3; overflow: hidden;
    background: var(--ev-bg);
    border-bottom: 1px solid var(--card-border);
  }
  .ev-card__art::after { /* the flyer's colour, as a thin rule along the bottom of the art */
    content: ''; position: absolute; inset: auto 0 0 0; height: 3px; background: var(--ev-accent);
  }
  .ev-card__art img {
    width: 100%; height: 100%; object-fit: cover; object-position: top;
    transition: transform var(--dur-emph) var(--ease-out);
  }
  a.ev-card:hover .ev-card__art img { transform: scale(1.03); }
  .ev-card__body { display: grid; gap: 4px; padding: 20px 22px 24px; flex: 1; align-content: start; }
  .ev-card__date { color: var(--text-3); font-weight: 600; }
  .ev-card__meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin-top: 8px; }
</style>
