---
import '../styles/tokens.css';
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import GlobalNav from '../components/GlobalNav.astro';
import TabBar from '../components/TabBar.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props { title?: string; description?: string; crumb?: string }
const { title, description = `${site.name}. ${site.tagline}`, crumb } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/brand/TEC_ICON_RED.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/AvianPro-Latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Charlotte-Italic.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      // Runs before paint: mark JS, and honour ?theme=light|dark for testing both looks.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var q = new URLSearchParams(location.search).get('theme');
          if (q === 'light' || q === 'dark') sessionStorage.setItem('tec-theme', q);
          if (q === 'auto') sessionStorage.removeItem('tec-theme');
          var t = sessionStorage.getItem('tec-theme');
          if (t) d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <GlobalNav />
    <main id="main" transition:name="main">
      <slot />
    </main>
    <Footer crumb={crumb ?? title} />
    <TabBar />
    <script>
      import { initMotion } from '../scripts/motion';
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
