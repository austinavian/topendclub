---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import PhotoRotator from '../components/PhotoRotator.astro';
import YouTube from '../components/YouTube.astro';
import site from '../data/site.json';
import sponsors from '../data/sponsors.json';
import { allEvents, usd } from '../lib/events';

const events = await allEvents();
const latest = events[events.length - 1];
const recent = events.slice(-4, -1).reverse();
const years = latest.year - site.founded;
// Videos for events already on this page: the latest (hero) and the recent cards.
const videos = [latest, ...recent].filter((e) => e.video);
---
<Base description={`${site.name}: a trackside cookout at zMAX Dragway since ${site.founded}, raising money for D.R.A.W.`}>
  <section class="hero">
    <PhotoRotator class="hero__photos" sizes="(max-width: 833px) 100vw, 62vw" caption />
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="t-eyebrow reveal">zMAX Dragway · Concord, North Carolina</p>
        <h1 class="t-charlotte hero__title reveal" style="--reveal-delay:60ms">Trackside<br />since 2012</h1>
        <p class="t-body-large t-secondary hero__intro reveal" style="--reveal-delay:140ms">
          After the race, the Top End Club cooks dinner for racers, crews and fans, and gives what it raises to D.R.A.W.
        </p>
        <p class="hero__links reveal" style="--reveal-delay:220ms">
          <a class="button" href={`/events/${latest.id}/`}>{latest.season} {latest.year} event</a>
          <a class="link-chevron" href="/events/">All events</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section--dark home-draw">
    <div class="container t-center stat">
      <p class="t-eyebrow reveal">Given to D.R.A.W. since {site.draw.since}</p>
      <p class="stat__value reveal reveal--scale" style="--reveal-delay:80ms">{usd(site.draw.total)}</p>
      <p class="stat__label reveal" style="--reveal-delay:160ms">Every dollar raised at the cookout goes to the Drag Racing Association of Women.</p>
      <p class="reveal home-draw__links" style="--reveal-delay:220ms"><a class="link-chevron" href="/draw/">See the giving history</a></p>
    </div>
  </section>

  {videos.length > 0 && (
    <section class="section container home-videos">
      <div class="home-head">
        <h2 class="t-headline reveal">Watch the nights</h2>
        <a class="link-chevron reveal" href={site.youtube} rel="noopener" target="_blank">YouTube channel</a>
      </div>
      <div class:list={['home-videos__grid', { 'is-pair': videos.length > 1 }]}>
        {videos.map((v, i) => (
          <figure class="home-video reveal" style={`--reveal-delay:${i * 80}ms`}>
            <YouTube id={v.video!} title={`The Top End Club, ${v.season} ${v.year}`} />
            <figcaption><a href={`/events/${v.id}/`} class="t-body t-semibold home-video__ev">{v.season} {v.year}</a> <span class="t-secondary">· {v.name}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="section container">
    <div class="home-head">
      <h2 class="t-headline reveal">Recent events</h2>
      <a class="link-chevron reveal" href="/events/#timeline">See all {events.length}</a>
    </div>
    <div class="grid grid--3 home-grid">
      {recent.map((e, i) => <EventCard event={e} delay={i * 80} />)}
    </div>
  </section>

  <section class="section section--surface">
    <div class="container home-club">
      <div class="tile home-club__tile reveal">
        <p class="t-eyebrow">The club</p>
        <h2 class="t-title-1">Started at zMAX Dragway in {site.founded}.</h2>
        <p class="t-body t-secondary">Rodney Smith, Tim Ridge, Jerry Bishop and James Larson founded the Top End Club. {years} years later, they still run it, with Jimmy Pless and Gerald Bridges.</p>
        <a class="link-chevron" href="/about/">About the club</a>
      </div>
      <div class="tile home-club__tile reveal" style="--reveal-delay:80ms">
        <p class="t-eyebrow">Sponsors</p>
        <h2 class="t-title-1">{sponsors.length} sponsors make every cookout possible.</h2>
        <p class="t-body t-secondary">{sponsors.slice(0, -1).map((s) => s.name).join(', ')} and {sponsors[sponsors.length - 1].name}</p>
        <a class="link-chevron" href="/sponsors/">Meet the sponsors</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: min(80vh, 760px); display: grid; align-items: center; padding-block: clamp(48px, 8vw, 112px); }
  .hero__inner { position: relative; z-index: 1; }
  .hero__text { display: grid; gap: var(--space-5); max-width: 520px; }
  .hero__title { font-size: clamp(56px, 7vw, 108px); }
  .hero__intro { max-width: 480px; }
  .hero__links { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; margin-top: var(--space-2); }
  /* The photos sit on the right and melt into the page on their left and bottom edges. */
  .hero :global(.hero__photos) {
    position: absolute; inset: 0 0 0 auto; width: 60%;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.35) 28%, #000 62%), linear-gradient(to top, transparent 0%, #000 22%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.35) 28%, #000 62%), linear-gradient(to top, transparent 0%, #000 22%);
    mask-composite: intersect;
    --rot-caption-bottom: 26%;
  }

  .home-draw { padding-block: clamp(72px, 10vw, 128px); }
  .home-draw .stat__label { max-width: 520px; margin-inline: auto; }
  .home-draw__links { margin-top: var(--space-6); }

  .home-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .home-grid { margin-top: var(--space-8); }
  .home-videos { padding-bottom: 0; }
  .home-videos__grid { display: grid; gap: var(--space-6); margin-top: var(--space-8); }
  .home-videos__grid.is-pair { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .home-video { margin: 0; display: grid; gap: 14px; }
  .home-video__ev { color: var(--text); }

  .home-club { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: var(--space-5); }
  .home-club__tile { display: grid; gap: var(--space-4); align-content: start; background: var(--elevated); border: 1px solid var(--card-border); }

  @media (max-width: 833px) {
    .hero { min-height: 0; display: block; padding-top: 0; }
    .hero :global(.hero__photos) {
      position: relative; inset: auto; width: 100%; height: clamp(300px, 86vw, 520px);
      -webkit-mask-image: linear-gradient(to top, transparent 0%, #000 38%);
      mask-image: linear-gradient(to top, transparent 0%, #000 38%);
    }
    .hero :global(.rot__caption) { display: none; }

    .hero__inner { margin-top: -20px; }
  }
</style>
