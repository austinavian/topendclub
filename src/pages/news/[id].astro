---
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { allEvents, longDate, shortDate, artKey, styleFor, compactUsd, type Ev } from '../../lib/events';
import photos from '../../data/photos-2026.json';

export async function getStaticPaths() {
  const events = await allEvents();
  const byId = Object.fromEntries(events.map((e) => [e.id, e])) as Record<string, Ev>;
  const posts = (await getCollection('news')).sort((a, b) => +a.data.date - +b.data.date);
  return posts.map((p, i) => ({
    params: { id: p.id },
    props: { post: p, ev: p.data.event ? byId[p.data.event] : undefined, older: posts[i - 1] ?? null, newer: posts[i + 1] ?? null },
  }));
}
interface Props { post: CollectionEntry<'news'>; ev?: Ev; older: CollectionEntry<'news'> | null; newer: CollectionEntry<'news'> | null }
const { post, ev, older, newer } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const s = ev ? styleFor(ev) : null;
const art = ev ? `/events/art/${artKey(ev)}` : null;
// The 2026 story has real photos of the night; older stories use the art made from their flyer.
const gallery = ev?.id === '2026-spring' ? photos : [];
const hero = gallery.find((p) => p.key === '2026-spring-draw-check-presentation');
const kindLabel = d.kind === 'after-event' ? 'After the event' : 'From the club';
---
<Base title={d.title} crumb="News" description={d.summary ?? d.title}>
  <article class="ns" style={s ? `--ev-accent:${s.accent}` : undefined}>
    <header class="container container--text ns-head">
      <p class="t-eyebrow ns-head__eyebrow reveal"><a href={`/news/#${d.kind === 'after-event' ? 'after-the-event' : 'club'}`}>{kindLabel}</a> <span aria-hidden="true">·</span> <time datetime={d.date.toISOString().slice(0, 10)}>{longDate(d.date)}</time></p>
      <h1 class="ns-head__title reveal" style="--reveal-delay:60ms">{d.title}</h1>
      {d.summary && <p class="t-body-large t-secondary reveal" style="--reveal-delay:120ms">{d.summary}</p>}
      <p class="t-callout t-tertiary ns-head__by reveal" style="--reveal-delay:160ms">By {d.author}</p>
    </header>

    {(hero || art) && (
      <figure class="container ns-cover reveal reveal--scale" style="--reveal-delay:120ms">
        {hero ? (
          <picture>
            <source type="image/webp" srcset={`/photos/2026/${hero.key}-sm.webp 960w, /photos/2026/${hero.key}.webp 1920w`} sizes="(max-width: 1068px) 100vw, 980px" />
            <img src={`/photos/2026/${hero.key}.jpg`} alt={hero.alt} width={hero.w} height={hero.h} style={`object-position:${hero.focus}`} fetchpriority="high" />
          </picture>
        ) : (
          <img class="ns-cover__art" src={`${art}-thumb.webp`} alt={`Artwork from the ${ev!.season} ${ev!.year} flyer`} width="1200" height="900" fetchpriority="high" />
        )}
        {hero && <figcaption class="t-caption t-tertiary">{hero.alt}</figcaption>}
      </figure>
    )}

    <div class="container container--text ns-body">
      <Content />
    </div>

    {ev?.video && (
      <section class="container ns-video">
        <h2 class="t-title-2 reveal">Watch the night</h2>
        <YouTube id={ev.video} title={`The Top End Club, ${ev.season} ${ev.year}`} poster={`/videos/${ev.id}-event-video`} class="reveal" />
      </section>
    )}

    {gallery.length > 1 && (
      <section class="container ns-gallery">
        <h2 class="t-title-2 reveal">Photos</h2>
        <ul class="ns-gallery__grid" role="list">
          {gallery.filter((p) => p !== hero).map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${(i % 3) * 60}ms`}>
              <figure>
                <picture>
                  <source type="image/webp" srcset={`/photos/2026/${p.key}-sm.webp 960w, /photos/2026/${p.key}.webp 1920w`} sizes="(max-width: 833px) 100vw, 480px" />
                  <img src={`/photos/2026/${p.key}.jpg`} alt={p.alt} width={p.w} height={p.h} style={`object-position:${p.focus}`} loading="lazy" decoding="async" />
                </picture>
                <figcaption class="t-caption t-tertiary">{p.alt}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    )}

    {ev && (
      <section class="container container--text ns-event">
        <a class="ns-event__card card reveal" href={`/events/${ev.id}/`}>
          <img src={`${art}-thumb-sm.webp`} alt="" width="600" height="450" loading="lazy" decoding="async" />
          <div>
            <p class="t-caption t-tertiary">The event</p>
            <p class="t-title-3">{ev.season} {ev.year} <span class="t-secondary">· {ev.name}</span></p>
            <p class="t-callout t-secondary">{shortDate(ev.date)}{ev.raised && ` · ${compactUsd(ev.raised)} raised for D.R.A.W.`}</p>
            <span class="link-chevron">See the event</span>
          </div>
        </a>
      </section>
    )}

    <nav class="container container--text ns-pager" aria-label="More stories">
      {older ? (
        <a class="ns-pager__link" href={`/news/${older.id}/`}><span class="t-caption t-tertiary">Older</span><span class="t-callout t-medium">{older.data.title}</span></a>
      ) : <span></span>}
      {newer && (
        <a class="ns-pager__link ns-pager__link--next" href={`/news/${newer.id}/`}><span class="t-caption t-tertiary">Newer</span><span class="t-callout t-medium">{newer.data.title}</span></a>
      )}
    </nav>
  </article>
</Base>

<style>
  .ns { --ns-accent: var(--accent); padding-bottom: var(--section-pad); }
  .ns-head { display: grid; gap: var(--space-4); padding-top: clamp(40px, 7vw, 88px); }
  .ns-head__eyebrow a { color: inherit; }
  .ns-head__title { font-size: clamp(34px, 5vw, 56px); line-height: 1.07; font-weight: 700; letter-spacing: -0.02em; text-wrap: balance; }
  .ns-head__by { margin-top: 4px; }

  .ns-cover { margin-top: clamp(32px, 5vw, 56px); }
  .ns-cover img { display: block; width: 100%; height: auto; max-height: 620px; object-fit: cover; border-radius: var(--radius-xl); background: var(--surface); box-shadow: var(--shadow-md); }
  .ns-cover .ns-cover__art { width: min(100%, 760px); margin-inline: auto; aspect-ratio: 4 / 3; }
  .ns-cover figcaption { margin-top: 10px; text-align: center; }

  .ns-body { margin-top: clamp(36px, 5vw, 56px); font-size: 19px; line-height: 1.58; letter-spacing: -0.005em; }
  .ns-body :global(p) { margin: 0 0 1.1em; }
  .ns-body :global(h2) { margin: 1.9em 0 0.6em; font-size: 28px; line-height: 1.15; font-weight: 700; letter-spacing: -0.015em; }
  .ns-body :global(ul) { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin: 0 0 1.2em; padding: 0; list-style: none; }
  .ns-body :global(li) {
    display: grid; gap: 2px; padding: 16px 18px; border-radius: var(--radius-md);
    background: var(--card); border: 1px solid var(--card-border); box-shadow: var(--shadow-sm);
    font-size: 24px; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .ns-body :global(li strong) { display: block; font-size: 13px; font-weight: 500; letter-spacing: 0; color: var(--text-3); }
  .ns-body :global(blockquote) {
    position: relative; margin: 0 0 0; padding: 28px 30px 6px 30px;
    border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--card-border);
    font-size: 17px; line-height: 1.6; color: var(--text);
  }
  .ns-body :global(blockquote::before) {
    content: '\201C'; position: absolute; top: -14px; left: 22px; font-family: Georgia, serif; font-size: 72px; line-height: 1;
    color: var(--ev-accent, var(--accent));
  }
  .ns-body :global(blockquote p) { margin-bottom: 1em; }
  .ns-body :global(.post-source) { margin-top: 12px; font-size: 13px; color: var(--text-3); }

  .ns-video, .ns-gallery { margin-top: clamp(48px, 7vw, 80px); display: grid; gap: var(--space-5); max-width: 980px; }
  .ns-gallery__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 0; padding: 0; }
  .ns-gallery__grid figure { margin: 0; display: grid; gap: 8px; }
  .ns-gallery__grid img { display: block; width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; border-radius: var(--radius-md); }

  .ns-event { margin-top: clamp(48px, 7vw, 80px); }
  .ns-event__card { display: grid; grid-template-columns: 140px 1fr; gap: 20px; align-items: center; padding: 16px; color: var(--text); }
  .ns-event__card:hover { text-decoration: none; }
  .ns-event__card img { width: 140px; height: 105px; object-fit: cover; border-radius: var(--radius-sm); }
  .ns-event__card > div { display: grid; gap: 4px; }
  .ns-event__card .link-chevron { color: var(--accent); margin-top: 2px; }

  .ns-pager { display: flex; justify-content: space-between; gap: 20px; margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--separator); }
  .ns-pager__link { display: grid; gap: 2px; max-width: 46%; color: var(--text); }
  .ns-pager__link:hover { text-decoration: none; color: var(--accent); }
  .ns-pager__link--next { text-align: right; margin-left: auto; }

  @media (max-width: 833px) { .ns-gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .ns-body { font-size: 17px; }
    .ns-body :global(h2) { font-size: 24px; }
    .ns-body :global(blockquote) { padding: 24px 20px 4px; font-size: 16px; }
    .ns-cover img { border-radius: var(--radius-lg); }
    .ns-gallery__grid { grid-template-columns: minmax(0, 1fr); }
    .ns-event__card { grid-template-columns: 96px 1fr; gap: 14px; padding: 12px; }
    .ns-event__card img { width: 96px; height: 72px; }
  }
</style>
