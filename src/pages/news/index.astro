---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { allEvents, shortDate, artKey, compactUsd, type Ev } from '../../lib/events';
import { coverFor } from '../../lib/news';

const events = await allEvents();
const byId = Object.fromEntries(events.map((e) => [e.id, e])) as Record<string, Ev>;
const posts = (await getCollection('news'))
  .map((p) => ({ ...p.data, id: p.id, ev: p.data.event ? byId[p.data.event] : undefined }))
  .sort((a, b) => +b.date - +a.date);
const [lead, ...rest] = posts.filter((p) => p.kind === 'after-event');
const club = posts.filter((p) => p.kind === 'club');
const years = [...new Set(rest.map((p) => p.date.getUTCFullYear()))];
const leadCover = coverFor(lead.id, lead.ev);
---
<Base title="News" description="After-event stories and news from the Top End Club at zMAX Dragway.">
  <PageHeader eyebrow="From the pits" title="News" intro="How every benefit night went, in the club's own words, plus news from the Top End Club." />

  <section class="container">
    <a class="nw-lead card reveal" href={`/news/${lead.id}/`}>
      <picture class="nw-lead__media">
        {leadCover.webp && <source type="image/webp" srcset={leadCover.webp} sizes="(max-width: 833px) 100vw, 600px" />}
        <img src={leadCover.src} alt="" width="1200" height="900" fetchpriority="high" decoding="async" style={leadCover.focus ? `object-position:${leadCover.focus}` : undefined} />
      </picture>
      <div class="nw-lead__text">
        <p class="t-eyebrow">Latest · <time datetime={lead.date.toISOString().slice(0, 10)}>{shortDate(lead.date)}</time></p>
        <h2 class="t-title-1">{lead.title}</h2>
        {lead.summary && <p class="t-body-large t-secondary">{lead.summary}</p>}
        <span class="link-chevron">Read the story</span>
      </div>
    </a>
  </section>

  <section class="section container" id="after-the-event">
    <h2 class="t-headline reveal">After the event</h2>
    <p class="t-body t-secondary nw-sub reveal">One story for each benefit night, with the totals for D.R.A.W.</p>
    {years.map((y) => (
      <div class="nw-year">
        <h3 class="nw-year__y t-title-2 t-tabular reveal">{y}</h3>
        <ul class="nw-list" role="list">
          {rest.filter((p) => p.date.getUTCFullYear() === y).map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
              <a class="nw-item card" href={`/news/${p.id}/`}>
                {p.ev && <img class="nw-item__thumb" src={`/events/art/${artKey(p.ev)}-thumb-sm.webp`} alt="" width="600" height="450" loading="lazy" decoding="async" />}
                <div class="nw-item__text">
                  <p class="t-caption t-tertiary"><time datetime={p.date.toISOString().slice(0, 10)}>{shortDate(p.date)}</time>{p.ev?.raised && <> · {compactUsd(p.ev.raised)} raised</>}</p>
                  <h4 class="t-title-3">{p.title}</h4>
                  {p.summary && <p class="t-callout t-secondary">{p.summary}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {club.length > 0 && (
    <section class="section section--surface" id="club">
      <div class="container">
        <h2 class="t-headline reveal">From the club</h2>
        <ul class="nw-club" role="list">
          {club.map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${i * 60}ms`}>
              <a class="nw-club__item card" href={`/news/${p.id}/`}>
                <p class="t-caption t-tertiary"><time datetime={p.date.toISOString().slice(0, 10)}>{shortDate(p.date)}</time></p>
                <h3 class="t-title-3">{p.title}</h3>
                {p.summary && <p class="t-callout t-secondary">{p.summary}</p>}
                <span class="link-chevron">Read</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .nw-lead { display: grid; grid-template-columns: 1.15fr 1fr; overflow: hidden; color: var(--text); }
  .nw-lead:hover { text-decoration: none; }
  .nw-lead__media { display: block; min-height: 100%; background: #000; }
  .nw-lead__media img { display: block; width: 100%; height: 100%; min-height: 340px; object-fit: cover; transition: transform var(--dur-emph) var(--ease-out); }
  .nw-lead:hover .nw-lead__media img { transform: scale(1.02); }
  .nw-lead__text { display: grid; align-content: center; gap: 14px; padding: clamp(28px, 4vw, 52px); }
  .nw-lead__text .link-chevron { color: var(--accent); }

  [id] { scroll-margin-top: calc(var(--nav-h) + 24px); }
  .nw-sub { margin-top: var(--space-2); }
  .nw-year { display: grid; grid-template-columns: 140px 1fr; gap: 24px; padding-block: 32px; border-top: 1px solid var(--separator); margin-top: var(--space-6); }
  .nw-year + .nw-year { margin-top: 0; }
  .nw-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; }
  .nw-item { display: grid; grid-template-columns: 112px 1fr; gap: 16px; align-items: start; height: 100%; padding: 14px; color: var(--text); }
  .nw-item:hover { text-decoration: none; }
  .nw-item:hover h4 { color: var(--accent); }
  .nw-item__thumb { width: 112px; height: 84px; object-fit: cover; border-radius: var(--radius-sm); background: var(--surface); }
  .nw-item__text { display: grid; gap: 4px; padding-top: 2px; }
  .nw-item h4 { transition: color var(--dur) var(--ease); }

  .nw-club { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: var(--space-7) 0 0; padding: 0; }
  .nw-club__item { display: grid; gap: 8px; height: 100%; padding: 22px 24px; color: var(--text); }
  .nw-club__item:hover { text-decoration: none; }
  .nw-club__item .link-chevron { color: var(--accent); margin-top: 4px; }

  @media (max-width: 1068px) { .nw-list { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 833px) {
    .nw-lead { grid-template-columns: minmax(0, 1fr); }
    .nw-lead__media img { min-height: 0; aspect-ratio: 4 / 3; }
    .nw-year { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .nw-club { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .nw-item { grid-template-columns: 88px 1fr; gap: 12px; padding: 12px; }
    .nw-item__thumb { width: 88px; height: 66px; }
  }
</style>
