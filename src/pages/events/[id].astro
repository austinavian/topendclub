---
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import { getCollection } from 'astro:content';
import { allEvents, styleFor, shortDate, longDate, raisedText, usd, compactUsd, artKey, type Ev } from '../../lib/events';
import details from '../../data/event-details.json';
import flyerSizes from '../../data/flyer-sizes.json';

type Detail = {
  when?: string; where?: string; sites?: string; honor?: string; food?: string;
  schedule?: [string, string][]; music?: { name: string; note?: string }[];
  auction?: string; sponsors?: string[]; recap?: string[];
};

export async function getStaticPaths() {
  const events = await allEvents();
  const stories = (await getCollection('news')).map((n) => ({ id: n.id, event: n.data.event }));
  return events.map((e, i) => ({ params: { id: e.id }, props: { e, all: events, prev: events[i - 1] ?? null, next: events[i + 1] ?? null, news: stories.find((n) => n.event === e.id) ?? null } }));
}
interface Props { e: Ev; all: Ev[]; prev: Ev | null; next: Ev | null; news: { id: string } | null }
const { e, all, prev, next, news } = Astro.props;
const d = ((details as Record<string, unknown>)[e.id] ?? {}) as Detail;
const s = styleFor(e);
const art = `/events/art/${artKey(e)}`;
const title = `${e.season} ${e.year}`;
const raised = raisedText(e);

const time = d.when ?? (d.schedule ? `From ${d.schedule[0][0]}` : null);
const facts = [
  { label: 'Date', value: shortDate(e.date) },
  ...(time ? [{ label: 'When', value: time }] : []),
  { label: 'Where', value: d.sites ? `Sites ${d.sites}` : 'zMAX Dragway', sub: d.sites ? 'Sportsman pits, zMAX' : undefined },
  ...(raised ? [{ label: 'Raised for D.R.A.W.', value: raised }] : []),
  ...(e.totalAfter ? [{ label: 'D.R.A.W. total after', value: usd(e.totalAfter) }] : []),
];

// Every D.R.A.W. night with a known amount, for the small chart. This event is highlighted.
const giving = all.filter((x) => x.raised);
const gMax = Math.max(...giving.map((x) => x.raised!));
const showChart = !!e.raised;
const rank = e.raised ? giving.filter((x) => x.raised! > e.raised!).length + 1 : 0;
const ordinal = (n: number) => n + (['th', 'st', 'nd', 'rd'][(n % 100 > 10 && n % 100 < 14) ? 0 : n % 10] ?? 'th');

const hasNight = d.schedule || d.food || d.music || d.auction || d.honor;
const fsz = e.flyer ? (flyerSizes as Record<string, number[]>)[e.flyer] : null;
const flyerName = `Top-End-Club-${e.season}-${e.year}-flyer.jpg`;
---
<Base title={title} crumb="Events" description={`${title} at zMAX Dragway: ${e.name}.${raised ? ` ${raised} raised for D.R.A.W.` : ''}`}>
  <section class:list={['evh', { 'is-dark': s.dark }]} style={`--ev-accent:${s.accent}; --ev-bg:${s.bg}`}>
    <div class="evh__wash" style={`background-image:url(${art}-wash.webp)`} aria-hidden="true"></div>
    <div class="container evh__inner">
      <div class="evh__text">
        <p class="t-eyebrow evh__eyebrow reveal"><a href="/events/">Events</a> <span aria-hidden="true">·</span> {longDate(e.date)}</p>
        <h1 class="t-charlotte t-charlotte--xl evh__title reveal" style="--reveal-delay:60ms">{e.season}<br />{e.year}</h1>
        <p class="evh__name reveal" style="--reveal-delay:120ms">{e.name}</p>
        {(e.private || d.honor) && (
          <p class="evh__badges reveal" style="--reveal-delay:160ms">
            {e.private && <span class="badge evh__badge">Private event</span>}
            {d.honor && <span class="badge evh__badge">In honor of {d.honor}</span>}
          </p>
        )}
      </div>
      <div class="evh__plate reveal reveal--scale" style="--reveal-delay:140ms">
        <img src={`${art}-thumb.webp`} alt={`Artwork from the ${title} flyer`} width="1200" height="900" />
      </div>
    </div>
  </section>

  <section class="container ev-facts-wrap">
    <dl class="facts">
      {facts.map((f, i) => (
        <div class="facts__item reveal" style={`--reveal-delay:${i * 50}ms`}>
          <dt class="t-caption t-secondary">{f.label}</dt>
          <dd class="t-title-3 t-tabular">{f.value}</dd>
          {f.sub && <dd class="t-caption t-secondary facts__sub">{f.sub}</dd>}
        </div>
      ))}
    </dl>
  </section>

  {(d.recap || e.notes || news) && (
    <section class="section--tight container ev-recap">
      <p class="t-eyebrow reveal">{e.date < new Date() ? 'How the night went' : 'About the night'}</p>
      <div class="ev-recap__body reveal" style="--reveal-delay:60ms">
        {(d.recap ?? [e.notes]).filter(Boolean).map((p) => <p class="t-body-large">{p}</p>)}
        {d.where && !d.sites && <p class="t-body t-secondary">Where: {d.where}.</p>}
        {news && <a class="link-chevron" href={`/news/${news.id}/`}>Read the full story</a>}
      </div>
    </section>
  )}

  {e.video && (
    <section class="section--tight container ev-video">
      <h2 class="t-headline reveal">Watch the night</h2>
      <YouTube id={e.video} title={`The Top End Club, ${title}`} class="reveal ev-video__player" />
    </section>
  )}

  {hasNight && (
    <section class="section section--surface ev-night">
      <div class="container">
        <h2 class="t-headline reveal">On the flyer</h2>
        <div class="night">
          {d.schedule && (
            <div class="night__card night__card--wide card reveal">
              <p class="night__label">Schedule</p>
              <ol class="sched" role="list">
                {d.schedule.map(([t, what]) => (
                  <li><span class="sched__t t-tabular">{t.replace(' PM', '')}<small>{t.includes('PM') ? 'PM' : ''}</small></span><span class="sched__w">{what}</span></li>
                ))}
              </ol>
            </div>
          )}
          {d.food && (
            <div class="night__card card reveal">
              <p class="night__label">Dinner</p>
              <p class="t-body">{d.food}</p>
            </div>
          )}
          {d.music && (
            <div class="night__card card reveal" style="--reveal-delay:60ms">
              <p class="night__label">Entertainment</p>
              <ul class="acts" role="list">
                {d.music.map((m) => <li><span class="t-body t-semibold">{m.name}</span>{m.note && <span class="t-caption t-secondary">{m.note}</span>}</li>)}
              </ul>
            </div>
          )}
          {d.auction && (
            <div class="night__card card reveal" style="--reveal-delay:120ms">
              <p class="night__label">Live auction</p>
              <p class="t-body">{d.auction}</p>
            </div>
          )}
          {d.where && d.sites && (
            <div class="night__card card reveal" style="--reveal-delay:120ms">
              <p class="night__label">Where</p>
              <p class="t-body">{d.where}, sites {d.sites}.</p>
            </div>
          )}
        </div>
        {d.sponsors && (
          <div class="ev-sponsors reveal">
            <p class="night__label">Sponsors on the flyer</p>
            <p class="t-body t-secondary">{d.sponsors.join(' · ')}</p>
          </div>
        )}
      </div>
    </section>
  )}

  {showChart && (
    <section class="section container ev-giving">
      <div class="ev-giving__head">
        <h2 class="t-headline reveal">{raised} for D.R.A.W.</h2>
        <p class="t-body-large t-secondary reveal">
          {rank === 1 ? 'The most the club has raised in one night.' : `The ${ordinal(rank)} biggest night of the ${giving.length} with a recorded amount.`}
          {' '}<a class="link-chevron" href="/draw/">Giving history</a>
        </p>
      </div>
      <ol class="mini reveal" role="list" aria-label="Amount raised at each event, this event highlighted">
        {giving.map((x) => (
          <li class:list={['mini__col', { 'is-this': x.id === e.id }]}>
            <a href={`/events/${x.id}/`} aria-label={`${x.season} ${x.year}: ${compactUsd(x.raised!)}`} title={`${x.season} ${x.year}: ${compactUsd(x.raised!)}`}>
              <span class="mini__bar" style={`height:${Math.max(2, (x.raised! / gMax) * 100)}%`}></span>
            </a>
          </li>
        ))}
      </ol>
      <p class="mini__axis t-caption t-tertiary" aria-hidden="true"><span>{giving[0].year}</span><span>{giving[giving.length - 1].year}</span></p>
    </section>
  )}

  <section class="section container ev-flyer" id="flyer">
    {e.flyer ? (
      <div class="ev-flyer__grid">
        <button class="ev-flyer__frame reveal" type="button" data-flyer-open aria-label="View the flyer full size">
          <img src={`/flyers/${e.flyer}.jpg`} alt={`The ${title} event flyer`} width={fsz?.[0]} height={fsz?.[1]} loading="lazy" decoding="async" />
        </button>
        <div class="ev-flyer__text reveal" style="--reveal-delay:80ms">
          <h2 class="t-headline">The flyer</h2>
          <p class="t-body-large t-secondary">The original invite for {title}, as it was handed out and posted.</p>
          <p class="ev-flyer__actions">
            <button class="button" type="button" data-flyer-open>View full size</button>
            <a class="button button--quiet" href={`/flyers/full/${e.flyer}.jpg`} download={flyerName}>Download</a>
          </p>
        </div>
      </div>
    ) : (
      <div class="ev-flyer__none reveal">
        <h2 class="t-headline">No flyer</h2>
        <p class="t-body-large t-secondary">{e.private ? 'This was a private event, so no flyer was made.' : 'No flyer was made for this event.'} The artwork on this page borrows from a neighboring year's flyer.</p>
      </div>
    )}
  </section>

  {e.flyer && (
    <dialog class="flyer-dlg" data-flyer-dialog aria-label={`${title} flyer`}>
      <form method="dialog"><button class="flyer-dlg__close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button></form>
      <img data-src={`/flyers/full/${e.flyer}.jpg`} alt={`The ${title} event flyer, full size`} />
      <a class="flyer-dlg__dl" href={`/flyers/full/${e.flyer}.jpg`} download={flyerName}>Download</a>
    </dialog>
  )}

  <nav class="container ev-pager" aria-label="More events">
    {prev ? <a class="card ev-pager__link" href={`/events/${prev.id}/`}><img src={`/events/art/${artKey(prev)}-thumb-sm.webp`} alt="" loading="lazy" /><span><span class="t-caption t-secondary">Previous</span><span class="t-body t-semibold">{prev.season} {prev.year}</span></span></a> : <span />}
    {next ? <a class="card ev-pager__link ev-pager__link--next" href={`/events/${next.id}/`}><span><span class="t-caption t-secondary">Next</span><span class="t-body t-semibold">{next.season} {next.year}</span></span><img src={`/events/art/${artKey(next)}-thumb-sm.webp`} alt="" loading="lazy" /></a> : <span />}
  </nav>
</Base>

<script>
  function initFlyer() {
    const dlg = document.querySelector<HTMLDialogElement>('[data-flyer-dialog]');
    if (!dlg) return;
    document.querySelectorAll('[data-flyer-open]').forEach((b) => b.addEventListener('click', () => {
      const img = dlg.querySelector('img')!;
      if (!img.src) img.src = img.dataset.src!;
      dlg.showModal();
    }));
    dlg.addEventListener('click', (ev) => { if (ev.target === dlg) dlg.close(); });
  }
  document.addEventListener('astro:page-load', initFlyer);
</script>

<style>
  /* Hero: the flyer's own colours, blurred into a wash, with its artwork on a plate. */
  .evh { position: relative; overflow: hidden; padding-block: clamp(40px, 7vw, 104px) clamp(48px, 7vw, 96px); isolation: isolate; }
  .evh__wash { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: center; opacity: 0.5; }
  .evh__wash::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 35%, transparent) 0%, transparent 40%, var(--bg) 100%); }
  .evh.is-dark { color: #f5f5f7; --text: #f5f5f7; --text-2: rgba(255, 255, 255, 0.78); background: var(--ev-bg); }
  .evh.is-dark .evh__wash { opacity: 1; }
  .evh.is-dark .evh__wash::after { background: linear-gradient(180deg, transparent 0%, transparent 55%, color-mix(in srgb, var(--ev-bg) 55%, #000) 100%); }
  .evh__inner { display: grid; grid-template-columns: 1fr minmax(0, 480px); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .evh__text { display: grid; gap: 16px; }
  .evh__eyebrow a { color: inherit; }
  .evh.is-dark .evh__eyebrow { color: rgba(255, 255, 255, 0.9); }
  .evh__title { color: var(--text); }
  .evh__name { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.2; font-weight: 600; letter-spacing: 0.004em; color: var(--text-2); }
  .evh__badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .evh__badge { background: color-mix(in srgb, var(--ev-accent) 16%, transparent); color: var(--text); }
  .evh.is-dark .evh__badge { background: rgba(255, 255, 255, 0.16); color: #fff; }
  .evh__plate img {
    width: 100%; border-radius: var(--radius-lg); transform: rotate(1.5deg);
    box-shadow: 0 30px 60px -24px color-mix(in srgb, var(--ev-accent) 55%, transparent), var(--shadow-lg);
    transition: transform var(--dur-emph) var(--ease-out);
  }
  .evh__plate:hover img { transform: rotate(0) translateY(-4px); }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .evh:not(.is-dark) .evh__wash { opacity: 0.22; } }
  :root[data-theme='dark'] .evh:not(.is-dark) .evh__wash { opacity: 0.22; }

  .ev-facts-wrap { padding-block: clamp(32px, 4vw, 48px) 0; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: var(--space-5); margin: 0; }
  .facts__item { padding-top: 14px; border-top: 2px solid var(--ev-accent, var(--text)); }
  .facts dd { margin: 6px 0 0; }
  .facts .facts__sub { margin-top: 2px; }

  .ev-recap { display: grid; grid-template-columns: 200px 1fr; gap: 24px; }
  .ev-recap__body { display: grid; gap: 14px; max-width: 740px; }
  .ev-recap__body .t-body-large { color: var(--text); }

  .ev-video { display: grid; gap: var(--space-6); padding-top: 0; }

  .ev-night .night { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--space-5); margin-top: var(--space-8); }
  .night__card { padding: 24px 26px 28px; display: grid; gap: 10px; align-content: start; border-top: 3px solid var(--ev-accent); }
  .night__card--wide { grid-column: 1 / -1; }
  .night__label { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .sched { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 0; margin: 4px 0 0; padding: 0; }
  .sched li { display: grid; gap: 4px; padding: 10px 14px; border-left: 1px solid var(--separator); }
  .sched li:first-child { border-left: 0; padding-left: 0; }
  .sched__t { font-size: clamp(24px, 2.4vw, 32px); font-weight: 600; letter-spacing: -0.01em; line-height: 1; }
  .sched__t small { font-size: 12px; font-weight: 600; margin-left: 3px; color: var(--text-3); }
  .sched__w { font-size: 14px; color: var(--text-2); }
  .acts { display: grid; gap: 10px; margin: 0; padding: 0; }
  .acts li { display: grid; gap: 1px; }
  .ev-sponsors { margin-top: var(--space-8); display: grid; gap: 8px; max-width: 820px; }

  .ev-giving__head { display: grid; gap: 10px; max-width: 760px; }
  .mini { display: flex; align-items: flex-end; gap: 3px; height: 120px; margin: var(--space-8) 0 0; padding: 0; border-bottom: 1px solid var(--separator); }
  .mini__col { flex: 1; height: 100%; }
  .mini__col a { display: flex; align-items: flex-end; height: 100%; }
  .mini__bar { display: block; width: 100%; border-radius: 3px 3px 0 0; background: color-mix(in srgb, var(--text) 16%, transparent); transition: background var(--dur) var(--ease); }
  .mini__col a:hover .mini__bar { background: color-mix(in srgb, var(--text) 36%, transparent); }
  .mini__col.is-this .mini__bar { background: var(--accent); }
  .mini__axis { display: flex; justify-content: space-between; margin-top: 8px; }

  .ev-flyer__grid { display: grid; grid-template-columns: minmax(0, 420px) 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .ev-flyer__frame {
    display: block; padding: 0; border: 1px solid var(--card-border); border-radius: var(--radius-md); overflow: hidden;
    background: var(--surface); cursor: zoom-in; box-shadow: var(--shadow-md); transition: transform var(--dur-emph) var(--ease-out);
  }
  .ev-flyer__frame:hover { transform: translateY(-4px); }
  .ev-flyer__frame img { display: block; width: 100%; height: auto; max-height: 72vh; object-fit: contain; }
  .ev-flyer__text { display: grid; gap: 14px; }
  .ev-flyer__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .ev-flyer__none { display: grid; gap: 12px; max-width: 680px; }

  .flyer-dlg { padding: 0; border: 0; background: transparent; max-width: min(96vw, 1100px); max-height: 94vh; overflow: auto; }
  .flyer-dlg::backdrop { background: rgba(0, 0, 0, 0.82); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .flyer-dlg img { display: block; width: 100%; height: auto; border-radius: 10px; }
  .flyer-dlg form { position: sticky; top: 0; z-index: 1; height: 0; }
  .flyer-dlg__close {
    position: absolute; top: 12px; right: 12px; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer;
    display: grid; place-items: center; color: #fff; background: rgba(0, 0, 0, 0.55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .flyer-dlg__dl { display: inline-block; margin: 12px 0 4px; color: #fff; font-size: 15px; }

  .ev-pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); padding-bottom: var(--section-pad); }
  .ev-pager__link { display: flex; align-items: center; gap: 16px; padding: 12px; }
  .ev-pager__link img { width: 96px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; flex: none; }
  .ev-pager__link > span { display: grid; gap: 2px; }
  .ev-pager__link--next { justify-content: flex-end; text-align: right; }

  @media (max-width: 833px) {
    .evh__inner { grid-template-columns: 1fr; }
    .evh__plate { max-width: 420px; }
    .ev-recap { grid-template-columns: 1fr; gap: 8px; }
    .ev-flyer__grid { grid-template-columns: 1fr; }
    .ev-flyer__frame { max-width: 360px; }
    .ev-pager__link img { width: 64px; }
  }
</style>
