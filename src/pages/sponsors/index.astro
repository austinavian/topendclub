---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import sponsors from '../../data/sponsors.json';
import details from '../../data/event-details.json';
import site from '../../data/site.json';
import { allEvents } from '../../lib/events';

const events = await allEvents();
// Sponsor names as printed on the flyers, matched loosely ("Gary's Golf Carts" = "Garys Golf Carts").
const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const onFlyer = (name: string) =>
  events.filter((e) => {
    const d = (details as Record<string, any>)[e.id];
    return d?.sponsors?.some((n: string) => norm(n) === norm(name));
  });

const list = sponsors.map((s) => {
  const evs = onFlyer(s.name);
  return { ...s, first: evs[0], count: evs.length };
});
---
<Base title="Sponsors" description={`The ${sponsors.length} sponsors behind every Top End Club cookout at zMAX Dragway.`}>
  <PageHeader eyebrow="Thank you" title="Sponsors" intro={`${sponsors.length} sponsors help cover the food, tents, signs and shirts, so what the club raises on the night can go to D.R.A.W.`} />

  <section class="section--tight container">
    <ul class="sp-grid" role="list">
      {list.map((s, i) => (
        <li class="sp card reveal" id={String(s.order)} style={`--reveal-delay:${(i % 3) * 60}ms`}>
          <div class="sp__logo">
            <img class:list={["sp__img sp__img--light", { "is-square": s.w / s.h < 1.8 }]} src={`/sponsors/${s.slug}.webp`} alt={`${s.name} logo`} width={s.w} height={s.h} loading="lazy" decoding="async" />
            <img class:list={["sp__img sp__img--dark", { "is-square": s.w / s.h < 1.8 }]} src={`/sponsors/${s.slug}-dark.webp`} alt={`${s.name} logo`} width={s.w} height={s.h} loading="lazy" decoding="async" />
          </div>
          <div class="sp__body">
            <h2 class="t-title-3">{s.name}</h2>
            {s.note && <p class="t-callout t-secondary">{s.note}</p>}
            {s.first && (
              <p class="t-caption t-tertiary sp__since">
                On the flyer since the <a href={`/events/${s.first.id}/`}>{s.first.season} {s.first.year} event</a>
              </p>
            )}
            {s.url && <a class="link-chevron sp__link" href={s.url} rel="noopener" target="_blank">Visit website</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section--surface">
    <div class="container t-center sp-cta">
      <h2 class="t-headline reveal">Want to back the next one?</h2>
      <p class="t-body-large t-secondary reveal" style="--reveal-delay:60ms">Sponsors are printed on the event flyer and listed here, all year. Send the club a message to get on the next flyer.</p>
      <p class="reveal" style="--reveal-delay:120ms"><a class="button" href={site.instagram} rel="noopener" target="_blank">Message us on Instagram</a></p>
    </div>
  </section>
</Base>

<style>
  .sp-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; }
  .sp { display: grid; grid-template-rows: auto 1fr; scroll-margin-top: calc(var(--nav-h) + 24px); }
  .sp:target { box-shadow: 0 0 0 2px var(--accent), var(--shadow-md); }
  .sp__logo {
    display: flex; align-items: center; justify-content: center; height: 168px; padding: 28px 32px;
    border-bottom: 1px solid var(--separator);
  }
  .sp__img { display: block; max-width: min(100%, 250px); max-height: 100%; width: auto; height: auto; object-fit: contain; }
  .sp__img.is-square { max-height: 108px; }
  .sp__img--dark { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sp__img--light { display: none; }
    :global(:root:not([data-theme="light"])) .sp__img--dark { display: block; }
  }
  :global(:root[data-theme="dark"]) .sp__img--light { display: none; }
  :global(:root[data-theme="dark"]) .sp__img--dark { display: block; }

  .sp__body { display: grid; align-content: start; gap: 6px; padding: 20px 24px 24px; }
  .sp__since a { color: inherit; text-decoration: underline; text-decoration-color: var(--separator); text-underline-offset: 2px; }
  .sp__since a:hover { color: var(--text); }
  .sp__link { margin-top: 6px; }

  .sp-cta { display: grid; justify-items: center; gap: var(--space-5); max-width: 640px; }

  @media (max-width: 1068px) { .sp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .sp-grid { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .sp__logo { height: 136px; padding: 22px 28px; }
    .sp__img.is-square { max-height: 84px; }
  }
</style>
